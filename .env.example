# SSB Mentor - Firebase & Application Configuration
# Copy this file to .env and replace placeholder values with your real Firebase Project credentials.

VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Offline / Demo Mode fallback (true by default when Firebase credentials are not provided)
VITE_USE_LOCAL_STORAGE_MOCK="true"
